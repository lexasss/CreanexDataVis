<Window x:Class="CreanexDataVis.Views.SelectCreanexLogFile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CreanexDataVis.Views"
        xmlns:vm="clr-namespace:CreanexDataVis.ViewModels"
        mc:Ignorable="d"
        Title="Select a Creanex log file"
        Height="220"
        Width="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <vm:SelectCreanexLogFile/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Label Grid.Row="0"
               Content="Files"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="4"/>
        
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectedIndex="{Binding SelectedItemIndex}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Key}"
                                   Margin="0,0,10,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Value}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <WrapPanel Grid.Row="2"
                   Margin="4"
                   HorizontalAlignment="Center">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="4,0"/>
                    <Setter Property="MinWidth" Value="72"/>
                    <Setter Property="Padding" Value="6"/>
                </Style>
            </WrapPanel.Resources>
            <Button Content="Select"
                    IsDefault="True"
                    IsEnabled="{Binding HasItemSelected}"
                    Command="{Binding AcceptCommand}"/>
            <Button Content="Cancel"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"/>
        </WrapPanel>
    </Grid>
</Window>
