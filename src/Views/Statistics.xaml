<Window x:Class="CreanexDataVis.Views.Statistics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CreanexDataVis.Views"
        xmlns:vm="clr-namespace:CreanexDataVis.ViewModels"
        mc:Ignorable="d"
        Title="Statistics"
        Height="300"
        Width="200"
        Icon="/Assets/Images/icon.png"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:Statistics/>
    </Window.DataContext>

    <StackPanel>
        <Label Content="Attention share"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="8"/>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Key}"
                                   Margin="0,0,10,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Value, StringFormat={}{0:F2}%}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
