<Window x:Class="CreanexDataVis.Views.Statistics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CreanexDataVis.Views"
        xmlns:vm="clr-namespace:CreanexDataVis.ViewModels"
        mc:Ignorable="d"
        Title="Statistics"
        Height="280"
        Width="900"
        Icon="/Assets/Images/icon.png"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <vm:Statistics/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="Title" TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="StackItemsControl" TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Column" TargetType="StackPanel">
            <Setter Property="Width" Value="220"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <StackPanel Style="{StaticResource Column}">
                <Label Style="{StaticResource Title}" 
                       Content="General"/>

                <ItemsControl Style="{StaticResource StackItemsControl}"
                              ItemsSource="{Binding GeneralItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Style="{StaticResource Column}">
                <Label Style="{StaticResource Title}" 
                       Content="Attention share"/>

                <ItemsControl Style="{StaticResource StackItemsControl}"
                              ItemsSource="{Binding AttentionShares}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value, StringFormat={}{0:F2}%}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Style="{StaticResource Column}">
                <Label Style="{StaticResource Title}" 
                       Content="Attention counts"/>

                <ItemsControl Style="{StaticResource StackItemsControl}"
                              ItemsSource="{Binding AttentionCounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Style="{StaticResource Column}">
                <Label Style="{StaticResource Title}" 
                       Content="Operations"/>

                <ItemsControl Style="{StaticResource StackItemsControl}"
                              ItemsSource="{Binding Operations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        
        <Grid Grid.Row="5">
            <WrapPanel Margin="4"
                       HorizontalAlignment="Center">
                <WrapPanel.Resources>
                    <Style x:Key="copy" TargetType="Button">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="FontSize" Value="20"/>
                        <Setter Property="Padding" Value="2,0,0,0"/>
                        <Setter Property="Foreground" Value="Gray"/>
                    </Style>

                    <ControlTemplate x:Key="copySign" TargetType="ContentControl">
                        <Grid>
                            <TextBlock Margin="-2,-2,0,0" Foreground="White">▮</TextBlock>
                            <TextBlock Margin="-2,-2,0,0">▯</TextBlock>
                            <TextBlock Margin="2,2,0,0" Foreground="White">▮</TextBlock>
                            <TextBlock Margin="2,2,0,0" >▯</TextBlock>
                        </Grid>
                    </ControlTemplate>
                </WrapPanel.Resources>
            
                <Button Style="{StaticResource copy}"
                        Command="{Binding CopyToClipboardCommand}">
                    <ContentControl Template="{StaticResource copySign}"/>
                </Button>
            </WrapPanel>
            <Label Content="Copied"
                   Margin="4"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Visibility="{Binding CopyToClipboardConfirmationVisibility}"/>
        </Grid>
    </Grid>
</Window>
